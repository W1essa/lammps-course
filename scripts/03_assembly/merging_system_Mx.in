# ==============================================================================
# MERGE WATER CYLINDER + MXENE SUBSTRATE
#
# Purpose:
#   Combine the MXene sheet (with specific termination) and the water cylinder.
#
# Run for different terminations:
#   lmpgpu -var term oh  -in 03_assembly/merging_system_Mx.in
#   lmpgpu -var term f   -in 03_assembly/merging_system_Mx.in
#   lmpgpu -var term mix -in 03_assembly/merging_system_Mx.in
# ==============================================================================

# --- Output folders ---
shell           mkdir -p ../data/mxene
shell           mkdir -p ../dump

# --- Initialization ---
units           real
dimension       3
boundary        p p f
atom_style      full

bond_style      harmonic
angle_style     harmonic
pair_style      zero 20.0 nocoeff

# --- Termination Selector ---
# Default to 'oh' if not specified in command line
variable        term index oh

# --- Box definition (from build_dims.vars generated by water_bar) ---
include         build_dims_${term}.vars

variable        xy_pad equal 60.0
variable        xlo_ext equal ${sys_xlo}-${xy_pad}
variable        xhi_ext equal ${sys_xhi}+${xy_pad}
variable        ylo_ext equal ${sys_ylo}-${xy_pad}
variable        yhi_ext equal ${sys_yhi}+${xy_pad}

# Z range: enough space for MXene (~10A) and water droplet (~50A)
variable        z_min equal -50.0
variable        z_max equal 250.0

region          main_box block ${xlo_ext} ${xhi_ext} ${ylo_ext} ${yhi_ext} ${z_min} ${z_max} units box

# 8 types total: 2 for Water + 6 for MXene (Ti, Ti, C, O, H, F)
create_box      8 main_box bond/types 1 angle/types 1 &
                extra/bond/per/atom 2 extra/angle/per/atom 2 &
                extra/special/per/atom 2

pair_coeff      * *

# Note: filenames must match your generation script outputs
variable        substrate_file string ../data/mxene/mxene_${term}_initial.data
variable        water_file string ../data/mxene/water_cylinder_mxene_${term}.data
variable        out_file       string ../data/mxene/merged_mxene_${term}_water.data

print "=============================================="
print "Termination type  : ${term}"
print "Substrate file    : ${substrate_file}"
print "Water file        : ${water_file}"
print "Output file       : ${out_file}"
print "=============================================="

# --- Read components ---
# Water (Type 1: O, Type 2: H)
read_data       ${water_file}     add append group Water    nocoeff
# MXene (Original Types 1-6 shift to 3-8)
read_data       ${substrate_file} add append offset 2 0 0 0 0 group MXene nocoeff

# --- Masses (Mandatory for write_data) ---
mass            1 15.9994   # O (water)
mass            2 1.008     # H (water)
mass            3 47.867    # Ti1 (MXene internal)
mass            4 47.867    # Ti2 (MXene surface)
mass            5 12.011    # C (MXene)
mass            6 15.999    # O (MXene termination)
mass            7 1.008     # H (MXene termination)
mass            8 18.998    # F (MXene termination placeholder)

bond_coeff      1 1.0 1.0
angle_coeff     1 1.0 109.47

# --- XY Centering ---
variable bx equal 0.5*(xlo+xhi)
variable by equal 0.5*(ylo+yhi)

# Center MXene
variable mcx equal xcm(MXene,x)
variable mcy equal xcm(MXene,y)
displace_atoms  MXene move $(v_bx-v_mcx) $(v_by-v_mcy) 0.0 units box

# Center Water
variable wcx equal xcm(Water,x)
variable wcy equal xcm(Water,y)
displace_atoms  Water move $(v_bx-v_wcx) $(v_by-v_wcy) 0.0 units box

# --- Trim water Y-footprint ---
variable        y_margin equal 2.0
variable        mymin0 equal bound(MXene,ymin)
variable        mymax0 equal bound(MXene,ymax)

region          keep_y block INF INF $(v_mymin0+v_y_margin) $(v_mymax0-v_y_margin) INF INF units box
group           keepY region keep_y
group           dropY subtract Water keepY
delete_atoms    group dropY mol yes

group           Water clear
group           Water type 1 2

# Final XY alignment
variable        mcx2 equal xcm(MXene,x)
variable        mcy2 equal xcm(MXene,y)
variable        wcx2 equal xcm(Water,x)
variable        wcy2 equal xcm(Water,y)
displace_atoms  Water move $(v_mcx2-v_wcx2) $(v_mcy2-v_wcy2) 0.0 units box

# --- Z Stacking ---
# bound(MXene, zmax) finds the highest atom (Hydrogen in OH case, Oxygen/Fluorine otherwise)
variable        m_top    equal bound(MXene,zmax)
variable        w_bottom equal bound(Water,zmin)
variable        gap      equal 3.0
variable        shift_z  equal v_m_top-v_w_bottom+v_gap

displace_atoms  Water move 0.0 0.0 ${shift_z} units box

# --- Final Cleanup and Export ---
velocity        all set 0.0 0.0 0.0 units box
reset_atoms     image Water
reset_atoms     id

write_data      ${out_file} nocoeff

print "SUCCESS: ${term}-terminated system written to ${out_file}"